    classDef hippoStyle fill:#f3e8ff,stroke:#9333ea,color:#3b0764;
    classDef fastStyle fill:#cffafe,stroke:#0891b2,color:#164e63;
    classDef memoryStyle fill:#ede9fe,stroke:#7c3aed,color:#2e1065;
    classDef stableStyle fill:#fee2e2,stroke:#dc2626,color:#450a0a;
    classDef affectStyle fill:#fce7f3,stroke:#db2777,color:#500724;
    classDef mapStyle fill:#d1fae5,stroke:#059669,color:#022c22;
    classDef modelStyle fill:#e2e8f0,stroke:#475569,color:#0f172a;
    classDef offlineStyle fill:#ffedd5,stroke:#ea580c,color:#431407;
