# Copy this file to .env and add your Anthropic API key.
ANTHROPIC_API_KEY=replace-with-your-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional locally. When set on the hosted service, visitors need this code.
TEAM_ACCESS_CODE=
# Set a random private value on the hosted service (at least 32 characters).
SESSION_SECRET=
